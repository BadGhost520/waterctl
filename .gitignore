# Gradle build output
/build
/app/build
/app/release
.gradle/
captures/
.externalNativeBuild/
.cxx/

# Android Studio / IntelliJ
# Machine- and user-specific: window layout, local paths, run configurations.
.idea/
*.iml
*.hprof

# Machine-specific SDK location (must not be shared; it hard-codes an absolute path)
local.properties

# Gradle daemon JVM criteria (generated by `gradle updateDaemonJvm`; a pinned toolchain
# would force every other machine to download that exact JDK)
gradle/gradle-daemon-jvm.properties

# OS noise
.DS_Store
Thumbs.db

# Generated icon previews (regenerate with tools/make_icon.py)
/tools/preview/

# Keystores and signing material
*.jks
*.keystore
keystore.properties
