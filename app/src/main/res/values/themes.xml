<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Material 3 is used because the layout relies on Material 3 attributes such as
      ?attr/textAppearanceHeadlineSmall, ?attr/colorOutline and ?attr/textAppearanceTitleMedium.
    -->
    <style name="Theme.Watercontrol" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
