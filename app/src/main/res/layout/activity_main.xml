<?xml version="1.0" encoding="utf-8"?>
<!--
  Vertical centring: `fillViewport` makes the LinearLayout fill the whole scroll viewport, and
  its own `gravity="center"` then centres the children as a block inside it. Centring the
  children (rather than the child inside the ScrollView) is what actually works, because a
  ScrollView always lays its direct child out from the top. While the content is shorter than
  the screen nothing scrolls; once the debug panel grows past the screen, scrolling resumes
  and `clipToPadding=false` keeps the padding from clipping the edges.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <!--
      `match_parent` height is deliberate here, and is what makes the centring work: with
      `fillViewport` the layout fills the viewport even when the content is short, giving
      `gravity="center"` something to centre the children inside. Lint's ScrollViewSize check
      assumes `wrap_content` is always correct for a ScrollView child, which does not hold for
      a centring wrapper.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        tools:ignore="ScrollViewSize">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/app_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:text="@string/app_subtitle"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:alpha="0.7" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <!--
                  The rescan control sits on the status row rather than in the action column:
                  it is a small utility, and a fourth full-width button would compete with the
                  three primary actions.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/device_name_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_not_connected"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="已连接：Water33982" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/refresh_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/action_refresh"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        app:icon="@drawable/ic_refresh"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        app:iconTint="?attr/colorPrimary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:text="@string/status_idle_hint"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:alpha="0.75"
                    tools:text="搜索到 6 个设备，点击“连接水控器”选择" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
          Three stacked actions, identical in size and style; only the fill marks the last one
          as primary.
            row 1: connect / disconnect
            row 2: reconnect to the last used device
            row 3: start / stop the session
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/connect_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_button_height"
            android:layout_marginTop="28dp"
            android:text="@string/action_connect"
            android:textSize="@dimen/action_button_text_size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reconnect_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_button_height"
            android:layout_marginTop="10dp"
            android:textSize="@dimen/action_button_text_size"
            android:visibility="gone"
            tools:text="连接到上次设备 Water25980"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_button_height"
            android:layout_marginTop="10dp"
            android:text="@string/action_start"
            android:textSize="@dimen/action_button_text_size"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/log_toggle"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="@string/action_show_log" />

        <HorizontalScrollView
            android:id="@+id/log_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/log_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textIsSelectable="true"
                tools:text="12:00:01.123  SCAN: found Water33982 (AA:BB:CC:DD:EE:FF)" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:alpha="0.5"
            tools:text="waterctl 移植版 · v2.1.4" />
    </LinearLayout>
</ScrollView>
